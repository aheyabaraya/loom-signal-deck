{
  "name": "loom-signal-deck",
  "version": "0.2.1-dev.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:governance && pnpm validate:marketing && pnpm validate:content-data && next build",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "validate:governance": "node scripts/validate-web-governance.mjs",
    "validate:marketing": "node scripts/validate-marketing-platform.mjs",
    "test:marketing:rls": "node scripts/test-marketing-rls.mjs",
    "test:deploy-proxy": "node scripts/test-deploy-proxy-packaging.mjs",
    "validate:harne": "node scripts/validate-harne.mjs",
    "validate:content-data": "node scripts/validate-content-data.mjs",
    "validate:member-assets": "node scripts/validate-member-assets.mjs",
    "validate:public-images": "node scripts/validate-public-images.mjs",
    "validate:all": "pnpm validate:governance && pnpm validate:marketing && pnpm validate:harne && pnpm validate:content-data && pnpm validate:member-assets && pnpm validate:public-images && pnpm type-check",
    "version:refresh": "node scripts/update-web-version-registry.mjs --write",
    "deploy:preview": "node scripts/deploy-safe.mjs",
    "deploy:prod": "node scripts/deploy-safe.mjs --prod",
    "test:deploy-safety": "node scripts/test-deploy-safety.mjs",
    "test:harne-security": "node scripts/test-harne-chat-security.mjs",
    "test:harne-db": "python3 scripts/test-harne-chat-db.py",
    "test:harne-vote": "node scripts/test-harne-vote-security.mjs",
    "test:harne-actor": "node scripts/test-harne-actor-binding.mjs",
    "test:harne-ui-state": "node scripts/test-harne-ui-state.mjs",
    "test:harne-regression": "pnpm test:harne-security && pnpm test:harne-vote && pnpm test:harne-actor && pnpm test:harne-ui-state"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
