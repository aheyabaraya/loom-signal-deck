# Public Supabase runtime configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://loom-signal-deck.vercel.app

# Web-owned marketing data mode. Keep preview until the marketing migration,
# two-user RLS test, consent copy, and preview QA have passed.
NEXT_PUBLIC_LOOM_MARKETING_MODE=preview

# Read-only operator console mode. Database mode additionally requires an
# authenticated user registered in private.loom_staff_users.
LOOM_STUDIO_MODE=preview

# Harne feature gates. Unset runtime defaults are off in lib/harne/config.ts.
# The public values below are an explicit operator opt-in for a configured
# environment after remote Harne migrations and at least one Supabase sign-in
# path (Anonymous, Email, or OAuth). Copying this file does not change those
# unset code defaults.
HARNE_DATA_MODE=supabase
HARNE_VOTE_MODE=public
HARNE_CHAT_MODE=public
HARNE_RESULT_VISIBILITY=after_vote

# Server-only OpenAI configuration. Never expose these through NEXT_PUBLIC_ variables.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-nano
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_INPUT_COST_PER_1M=0.75
OPENAI_OUTPUT_COST_PER_1M=4.5

# Shared staff gate when HARNE_VOTE_MODE=staff or HARNE_CHAT_MODE=staff.
HARNE_STAFF_USER_IDS=

# Payments are intentionally not configurable in this release. The checkout
# API remains closed and no payment key belongs in this file.

# Server only: required by trusted Harne vote/chat RPCs. Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
